  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Ready to quack some ideas down?\n\nJust double-tap the duck\u2019s head
    to get started! Once you do, your duck is all ears and your voice will be magically
    turned into text in 10 seconds.\n\nYou can wait for the timer to end and a cute
    little pop-up will appear with your note. If you want to process your voice immediately,
    just press this button:\n\nThen grab your note, toss it onto the draft board,
    or place it proudly on the final board.\n\nBe creative, move things around, and
    most of all, have fun taking notes!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
